{
  "name": "@fizzup/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "migrations-create": {
        "executor": "nx:run-commands",
        "options": {
          "command": "MIKRO_ORM_ENV=.env.development node --conditions=@fizzup/source ./node_modules/.bin/mikro-orm migration:create --config apps/api/src/app/config/mikro-orm.config.ts"
        }
      },
      "migrations-up": {
        "executor": "nx:run-commands",
        "options": {
          "command": "MIKRO_ORM_ENV=.env.development node --conditions=@fizzup/source ./node_modules/.bin/mikro-orm migration:up --config apps/api/src/app/config/mikro-orm.config.ts"
        }
      },
      "migrations-down": {
        "executor": "nx:run-commands",
        "options": {
          "command": "MIKRO_ORM_ENV=.env.development node --conditions=@fizzup/source ./node_modules/.bin/mikro-orm migration:down --config apps/api/src/app/config/mikro-orm.config.ts"
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "MIKRO_ORM_ENV=.env.development node --conditions=@fizzup/source ./node_modules/.bin/mikro-orm seeder:run --class DatabaseSeeder --config apps/api/src/app/config/mikro-orm.config.ts"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@fizzup/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@fizzup/api:build:development"
          },
          "production": {
            "buildTarget": "@fizzup/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@mikro-orm/cli": "^6.6.9",
    "@nestjs/common": "^11.0.0",
    "dotenv": "^16.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
